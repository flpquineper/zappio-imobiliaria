# Banco PostgreSQL (local: `pnpm db:up` sobe o container na porta 5433; produção: Neon)
DATABASE_URL=postgres://zappio:zappio@localhost:5433/zappio
# String aleatória longa: `openssl rand -hex 32`
PAYLOAD_SECRET=
# URL pública do site, sem barra no final (usada em links de WhatsApp, SEO, sitemap e prévia)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (fotos). Deixe vazio em desenvolvimento para usar a pasta local media/.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Seed (opcional). Fora do banco local exige SEED_ALLOW_REMOTE=true e SEED_ADMIN_PASSWORD.
# SEED_ADMIN_EMAIL=admin@zappio.com.br
# SEED_ADMIN_PASSWORD=
# SEED_ALLOW_REMOTE=true
